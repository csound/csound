prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@LIBRARY_INSTALL_DIR@
includedir=${prefix}/@HEADER_INSTALL_DIR@

Name: Csound
Description: A sound and music computing system
Version: @CS_VERSION@.@CS_SUBVER@.@CS_PATCHLEVEL@
Libs: @CSOUND_LINK_FLAGS@
Libs.private: @CSOUND_PRIVATE_LIBS@
Cflags: -I${includedir}
