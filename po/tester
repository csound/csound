#!/bin/sh
# Check headers and printf arguments, including entries awaiting review.
set -eu
cd "$(dirname "$0")/.."

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/csound-po-check.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT HUP INT TERM

for catalog in po/*.po; do
    printf '%s\n' "$catalog"
    msgattrib --clear-fuzzy --no-obsolete "$catalog" > "$tmpdir/catalog.po"
    msgfmt --check --output-file=/dev/null "$tmpdir/catalog.po"
done
