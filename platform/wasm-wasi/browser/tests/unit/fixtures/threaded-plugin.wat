;; Tiny shared PIC plugin for loader tests. The test adds its dylink.0 header.
(module
  (import "env" "memory" (memory 1 2 shared))
  (import "env" "__indirect_function_table" (table 1 funcref))
  (import "env" "__memory_base" (global $base i32))
  (import "env" "__table_base" (global $table i32))
  (global $tls (mut i32) (i32.const 0))
  (global (export "__tls_size") i32 (i32.const 4))
  (global (export "__tls_align") i32 (i32.const 4))
  (func $start
    (if (i32.eqz (i32.atomic.rmw.cmpxchg (global.get $base) (i32.const 0) (i32.const 1)))
      (then (i32.store offset=8 (global.get $base) (i32.const 13)))))
  (start $start)
  (func (export "__wasm_call_ctors")
    (i32.store offset=4 (global.get $base)
      (i32.add (i32.load offset=4 (global.get $base)) (i32.const 1))))
  (func (export "__wasm_init_tls") (param $pointer i32)
    (global.set $tls (local.get $pointer))
    (i32.store (local.get $pointer) (i32.const 17)))
  (func $step (result i32)
    (i32.store (global.get $tls) (i32.add (i32.load (global.get $tls)) (i32.const 1)))
    (i32.load (global.get $tls)))
  (elem (global.get $table) $step)
  (func (export "csound_opcode_init") (result i32)
    (i32.load offset=8 (global.get $base)))
)
