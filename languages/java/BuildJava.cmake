file(GLOB sources "${SOURCE_DIR}/*.java")
if(NOT sources)
    message(FATAL_ERROR "SWIG did not generate Java sources")
endif()
file(REMOVE_RECURSE "${CLASS_DIR}")
file(MAKE_DIRECTORY "${CLASS_DIR}")
set(source_list "${CLASS_DIR}/sources.txt")
file(WRITE "${source_list}" "")
foreach(source IN LISTS sources)
    file(APPEND "${source_list}" "\"${source}\"\n")
endforeach()
execute_process(COMMAND "${JAVAC}" --release 8 -d "${CLASS_DIR}" "@${source_list}"
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Compiling csnd7 Java sources failed: ${result}")
endif()
file(REMOVE "${source_list}")
execute_process(COMMAND "${JAR}" cf "${JAR_FILE}" -C "${CLASS_DIR}" .
    RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Creating csnd7.jar failed: ${result}")
endif()
