<CsTest>
description = "End tags after a line's leading blanks that fill a chunk, or that leave the chunk's end to cut the tag"
args = ["-nd"]

[expect]
exit = 0
output = ["instr 1 ran"]
</CsTest>
<CsoundSynthesizer>
<CsInstruments>

instr 1
  prints "instr 1 ran\n"
endin

; The next line's first 4095 bytes are blanks, a chunk of their own.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                               </CsInstruments>
<CsScore>
i 1 0 0
; The next line's 4091st byte starts the tag, which the first chunk cuts.
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                          </CsScore>
</CsoundSynthesizer>
