<CsTest>
description = "A </CsOptions> at byte 4096 of a long line, inside a value, ends no section"
args = ["-nd"]

[expect]
exit = 0
output = ["CsOptions taken"]
output_excludes = ["unknown CSD tag"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
--omacro:</CsOptions>
--omacro:FROM_CSOPTIONS=1
</CsOptions>
<CsInstruments>

instr 1
#ifdef FROM_CSOPTIONS
  prints "CsOptions taken\n"
#else
  prints "CsOptions ignored\n"
#end
#ifdef NOT_AN_OPTION
  prints "a comment was read\n"
#end
  prints "ksmps %d\n", ksmps
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
