<CsTest>
description = "The last byte of a chunk of a too-long line is kept"
args = ["-nd"]

[expect]
exit = 0
output = ["ksmps 16"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
--omacro: --ksmps=16; a comment
</CsOptions>
<CsInstruments>

instr 1
  prints "ksmps %d\n", ksmps
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
