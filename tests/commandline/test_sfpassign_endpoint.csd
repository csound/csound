<CsTest>
description = "sfpassign accepts assignments ending at the final preset handle"
[expect]
exit = 0
</CsTest>
<CsoundSynthesizer>
<CsOptions>
-n -d -m0
</CsOptions>
<CsFileB filename="sfpassign-endpoint.sf2">
UklGRrACAABzZmJrTElTVCYAAABJTkZPaWZpbAQAAAACAAEASU5BTQ4AAABQcmVzZXQgYm91bmRz
AExJU1ToAAAAc2R0YXNtcGzcAAAAABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQABAAEAAQ
