<CsTest>
description = "A </CsScore> that starts a chunk of a long line, not the line, ends nothing"
args = ["-nd"]

[expect]
exit = 0
output = ["instr 2 ran"]
</CsTest>
<CsoundSynthesizer>
<CsInstruments>

instr 2
  prints "instr 2 ran\n"
endin

</CsInstruments>
<CsScore>
; The next line's 4096th byte starts the tag, inside its comment.
;</CsScore> is comment text here
i 2 0 0
</CsScore>
</CsoundSynthesizer>
