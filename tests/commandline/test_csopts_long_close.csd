<CsTest>
description = "Text after a closing delimiter is ignored to the end of a too-long line"
args = ["-nd"]

[expect]
exit = 0
output = ["CsOptions taken"]
output_excludes = ["text after the comment taken"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
/* a comment */  --omacro:AFTER_COMMENT=1
--omacro:FROM_CSOPTIONS=1
</CsOptions>
<CsInstruments>

instr 1
#ifdef AFTER_COMMENT
  prints "text after the comment taken\n"
#end
#ifdef FROM_CSOPTIONS
  prints "CsOptions taken\n"
#else
  prints "CsOptions ignored\n"
#end
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
