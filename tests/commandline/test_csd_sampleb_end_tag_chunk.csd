<CsTest>
description = "A skipped <CsSampleB>'s end tag, cut by the end of a chunk of a long line, is found"
args = ["-nd"]

[expect]
exit = 0
output = ["<CsSampleB> without a file number, skipped", "instr 1 ran"]
output_excludes = ["Missing end tag"]
</CsTest>
<CsoundSynthesizer>
<CsInstruments>

instr 1
  prints "instr 1 ran\n"
endin

</CsInstruments>
<CsScore>
i 1 0 0
</CsScore>
<CsSampleB filename="sample">
</CsSampleB>
</CsoundSynthesizer>
