<CsTest>
description = "A line comment longer than 4095 bytes in <CsOptions> is a comment to its end"
args = ["-nd"]

[expect]
exit = 0
output = ["CsOptions taken"]
output_excludes = ["a comment was read"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
--omacro:FROM_CSOPTIONS=1
;  --omacro:NOT_AN_OPTION=1
</CsOptions>
<CsInstruments>

instr 1
#ifdef FROM_CSOPTIONS
  prints "CsOptions taken\n"
#else
  prints "CsOptions ignored\n"
#end
#ifdef NOT_AN_OPTION
  prints "a comment was read\n"
#end
  prints "ksmps %d\n", ksmps
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
