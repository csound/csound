<CsTest>
description = "A block comment that opens at byte 4095 or 4096 of a long line, after a blank, hides its tags"
args = ["-nd"]

[expect]
exit = 0
output = ["CsOptions taken"]
output_excludes = ["unknown CSD tag"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
--omacro: /* split between two chunks
</CsOptions>
</CsoundSynthesizer>
*/
--omacro: /* after a blank
</CsOptions>
</CsoundSynthesizer>
*/
--omacro:  /* after blanks
</CsOptions>
</CsoundSynthesizer>
*/
--omacro:FROM_CSOPTIONS=1
</CsOptions>
<CsInstruments>

instr 1
#ifdef FROM_CSOPTIONS
  prints "CsOptions taken\n"
#else
  prints "CsOptions ignored\n"
#end
#ifdef NOT_AN_OPTION
  prints "a comment was read\n"
#end
  prints "ksmps %d\n", ksmps
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
