<CsoundSynthesizer>
<CsOptions>
-n -d -m0
</CsOptions>
<CsInstruments>
sr = 8192
ksmps = 16
nchnls = 1
0dbfs = 1
gkChecks init 0

instr 1
 kBlock init 0
 kBlock += 1
 kFreq = (kBlock < 3 ? 1024 : 2048)
 aInput = .1
 aOut clfilt aInput, kFreq, p4, 2, p5, (p5 == 1 ? p6 : 1), (p5 == 2 ? p6 : -60)
 kActual vaget (kBlock == 4 ? 15 : 0), aOut
 kExpected = (kBlock == 1 ? p7 : (kBlock == 3 ? p8 : p9))
 if kBlock == 1 || kBlock == 3 || kBlock == 4 then
  if !(abs(kActual-kExpected) < .00005) then
   printks "clfilt type=%g kind=%g ripple=%g block=%g actual=%g expected=%g\n", 0, p4, p5, p6, kBlock, kActual, kExpected
   exitnowk(-1)
  endif
 endif
 if kBlock == 4 then
  gkChecks += 1
 endif
endin

instr 99
 if i(gkChecks) != 16 then
  prints "clfilt checks did not complete\n"
  exitnow(-1)
 endif
endin
</CsInstruments>
<CsScore>
; High-precision step-response values at samples 0, 32, and 63.
; The cutoff changes from sr/8 to sr/4 at sample 32.
; p4=low/high pass, p5=kind, p6=ripple or attenuation.
i 1 0 .0078125 0 1 1 0.010255744141814216 0.089124934499337196 0.089125093813371683
i 1 0 .0078125 0 1 1e-8 0.096711261667946074 0.099476197512051585 0.099425829231264281
i 1 0 .0078125 0 1 1e-20 0.099996655337198122 0.099996658917080778 0.10000333761586608
i 1 0 .0078125 0 2 -60 0.00013084365788853665 0.040036991731421764 0.099691589048437336
i 1 0 .0078125 0 2 -1e-8 0.099997907175971689 0.10000580567645137 0.099995688982980254
i 1 0 .0078125 0 2 -1e-20 0.099999999997907218 0.10000000000580962 0.099999999995683052
i 1 0 .0078125 1 1 1 0.056838554533765591 1.4895625937612893e-7 -9.5345951563526066e-16
i 1 0 .0078125 1 1 1e-8 0.099427797053300916 0.066154031183903854 0.038593110811384636
i 1 0 .0078125 1 1 1e-20 0.099999426138635869 0.099962702370391095 0.099927125729990081
i 1 0 .0078125 1 2 -60 0.0010871076033499573 -0.0000063540329543672038 0.000068726225982487508
i 1 0 .0078125 1 2 -1e-8 0.099998705595008565 0.099997823172170845 0.099996011601785367
i 1 0 .0078125 1 2 -1e-20 0.099999999998705587 0.099999999997822269 0.099999999996007150
i 1 0 .0078125 0 1 0 0.010255744141814216 0.089124934499337196 0.089125093813371683
i 1 0 .0078125 1 1 -1 0.056838554533765591 1.4895625937612893e-7 -9.5345951563526066e-16
i 1 0 .0078125 0 2 0 0.00013084365788853665 0.040036991731421764 0.099691589048437336
i 1 0 .0078125 1 2 60 0.0010871076033499573 -0.0000063540329543672038 0.000068726225982487508
i 99 .02 .001
e
</CsScore>
</CsoundSynthesizer>
