<CsTest>
description = "An option across bytes 4095 and 4096 of a long line is read whole"
args = ["-nd"]

[expect]
exit = 0
output = ["ksmps 16"]
output_excludes = ["Invalid arguments"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
--omacro: --ksmps=16
</CsOptions>
<CsInstruments>

instr 1
#ifdef FROM_CSOPTIONS
  prints "CsOptions taken\n"
#else
  prints "CsOptions ignored\n"
#end
#ifdef NOT_AN_OPTION
  prints "a comment was read\n"
#end
  prints "ksmps %d\n", ksmps
endin

</CsInstruments>
<CsScore>
i 1 0 0.01
</CsScore>
</CsoundSynthesizer>
