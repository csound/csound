<CsTest>
description = "#include and #includestr names of 100 bytes and more are read whole, and one longer than 1023 bytes is ignored with the rest of its line"

[expect]
exit = 0
output = ["#include file name longer than 1023 bytes ignored", "every include arrived"]
</CsTest>
<CsoundSynthesizer>
<CsOptions>
-n -d
</CsOptions>
<CsInstruments>
; The name was copied into a buffer of 100 bytes with no bound, and by
; #includestr cut at 127: one of 130 bytes overflowed the first, and one of
; 200 named another file through the second.
giIncludedOrc init 0
giIncludes init 0
#include "./././././././././././././././././././././././././././././././././././././././././././././././././././././include_name_fixture.orc"
giIncludes += giIncludedOrc
giIncludedOrc = 0
#includestr "././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././include_name_fixture.orc"
giIncludes += giIncludedOrc
; Longer than any name is taken: ignored, and the rest of its line with it.
#include "././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././no_such_file.orc" not orchestra code
giScored init 0

instr Seen
  giScored += p4
endin

instr Check
  if giIncludes != 2 || giScored != 4 then
    prints("%d of 2 orchestra includes and %d of 4 score lines arrived\n", giIncludes, giScored)
    exitnow(1)
  endif
  prints("every include arrived\n")
endin
</CsInstruments>
<CsScore>
#include "./././././././././././././././././././././././././././././././././././././././././././././././././././././include_name_fixture.sco"
#includestr "././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././include_name_fixture.sco"
#include "././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././././no_such_file.orc" not score either
i "Check" 0.1 0.01
</CsScore>
</CsoundSynthesizer>
