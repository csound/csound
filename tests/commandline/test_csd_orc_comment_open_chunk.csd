<CsTest>
description = "A /* that starts a chunk of a long line, not the line, opens no comment"
args = ["-nd"]

[expect]
exit = 0
output = ["instr 1 ran"]
</CsTest>
<CsoundSynthesizer>
<CsInstruments>

; The next line's 4096th byte starts a /* inside its string.
gS_name = "*.wav"

instr 1
  prints "instr 1 ran\n"
endin

</CsInstruments>
<CsScore>
i 1 0 0
</CsScore>
</CsoundSynthesizer>
