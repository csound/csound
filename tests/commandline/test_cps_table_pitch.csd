<CsoundSynthesizer>
<CsOptions>
-n -d -m0
</CsOptions>
<CsInstruments>
sr = 8192
ksmps = 16
nchnls = 1
0dbfs = 1
giScale1 ftgen 1, 0, -4, -2, 1, 1.25, 1.5, 1.75
giScale2 ftgen 2, 0, -5, -2, 1, 1.125, 1.375, 1.625, 1.875
giScale3 ftgen 3, 0, -1, -2, 1
giScale4 ftgen 4, 0, -4, -2, 1, 1.189207115002721, 1.4142135623730951, 1.681792830507429
instr 1
 iActual cpsxpch p4, -p5, p6, 100
 iStandard cps2pch p4, -p5
 if !(abs(iActual - p7) <= .00001 * p7) || !(abs(iStandard - p8) <= .00001 * p8) then
  prints "pitch=%g table=%g: cpsxpch=%g expected=%g; cps2pch=%g expected=%g\n", p4, p5, iActual, p7, iStandard, p8
  exitnow(-1)
 endif
 ; An equal-tempered table must agree with the equal-division form.
 if p5 == 4 then
  iEqual cpsxpch p4, 4, 2, 100
  iEqual2 cps2pch p4, 4
  if !(abs(iActual - iEqual) <= .00001 * iEqual) || !(abs(iStandard - iEqual2) <= .00001 * iEqual2) then
   prints "table and equal-division pitch conversions disagree\n"
   exitnow(-1)
  endif
 endif
endin
</CsInstruments>
