<CsTest>
description = "A */ across two chunks of a long line closes a comment in <CsInstruments>"
args = ["-nd"]

[expect]
exit = 0
output = ["instr 1 ran"]
</CsTest>
<CsoundSynthesizer>
<CsInstruments>

instr 1
  prints "instr 1 ran\n"
endin
; The next line is 4096 bytes: its first 4095 end with the * of its */.
/**/
</CsInstruments>
<CsScore>
i 1 0 0
</CsScore>
</CsoundSynthesizer>
