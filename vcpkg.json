{
    "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
    "name": "csound",
    "version-string": "7.0",
    "builtin-baseline": "5dfa11cf88a8da8877b54fcbc5f6db78bc13f75a",
    "dependencies": [
        "zlib",
        "libsamplerate",
        {
            "name": "portmidi",
            "platform": "!android & !emscripten & !ios"
        },
        {
            "name": "liblo",
            "platform": "!android & !emscripten & !ios"
        },
        {
            "name": "gtest",
            "platform": "!android & !emscripten & !ios"
        },
        {
            "name": "jack2",
            "platform": "linux|osx"
        },
        {
            "name": "portaudio",
            "platform": "!android & !emscripten & !ios"
        },
        {
            "name": "dirent",
            "platform": "windows"
        },
        {
            "name": "libsndfile",
            "platform": "x64",
            "features": [
                "external-libs",
                "mpeg"
            ]
        },
        {
            "name": "gettext",
            "platform": "linux|osx"
        }
    ]
}
